{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutrifacts-api",
  // The justin.garcia@gmail.com Cloudflare account. Not a secret; it lets CI deploy with just an API token.
  "account_id": "e55f224854d9d92acc44912ed036cf0c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // A vision-capable model from your AI& account. List them with the command in README.md,
    // or compare them on real photos with `npm run compare -- photo.jpg`.
    "AIAND_MODEL": "qwen/qwen3.8-27b",
    // Reasoning level when the app doesn't pick one. Must be in the model's reasoning_efforts
    // (qwen3.8-27b: none, low, medium, xhigh). Its own default is xhigh, which is slow and costly.
    "AIAND_REASONING_EFFORT": "low"
  },
  // Secrets (not in this file): AIAND_API_KEY, and optionally APP_TOKEN.
  // Set them with `npx wrangler secret put <NAME>`.
  "ratelimits": [
    {
      // Per client IP: 10 label reads a minute.
      "name": "READ_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
